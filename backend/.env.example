# Backend Server Port (automatically set by Heroku / Render, defaults to 8080 locally)
PORT=8080
HOST=0.0.0.0

# Allowed CORS Origins (comma-separated list of live frontend URLs)
# Add your live deployed frontend URL on Vercel here
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app

# Optional: Specific Frontend URL (will automatically be allowed by CORS)
FRONTEND_URL=https://your-app.vercel.app

# Optional: Elexon BMRS API Base URL
ELEXON_API_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1/datasets
